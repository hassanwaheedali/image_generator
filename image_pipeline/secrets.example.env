# ===========================================================================
#   PASTE YOUR SECRET KEYS HERE  --  this is the main secrets file.
#
#   Where:  the top level of your workspace, next to the "image_pipeline" folder.
#   How:    type the key after the "=" sign. No quotes. No spaces.
#
#           FREEIMAGE_API_KEY=abc123yourkeyhere
#
#   Then run the pipeline exactly as usual:
#           cd image_pipeline
#           python3 main.py --input sample_input.csv --workers 4
#
#   A key exported in the shell (or a Colab secret) always wins over this file.
#   This file is listed in .gitignore - it is never committed or shared.
# ===========================================================================

# freeimage.host API key(s) (primary uploader; comma-separated for round-robin rotation)
# Example: FREEIMAGE_API_KEY=key1,key2,key3
FREEIMAGE_API_KEY=

# ImgBB API key(s) (automatic fallback if freeimage.host fails, or primary if freeimage key is empty)
# Supports comma-separated keys for round-robin rotation with automatic retirement on rate limit.
# Get your free key instantly at: https://api.imgbb.com/
IMGBB_API_KEY=

# ImageKit.io Private API key(s) (automatic fallback / high-quota CDN; comma-separated keys supported)
# Get your private key from ImageKit Dashboard -> Developer Options -> API Keys
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Optional Media Library folder inside ImageKit (e.g. /products)
# IMAGEKIT_FOLDER=/products

# APILayer API key(s) (secondary automatic fallback; comma-separated keys also supported)
# Get your key at: https://apilayer.com/marketplace/image_upload-api
APILAYER_API_KEY=

# ---------------------------------------------------------------------------
# Optional extras - leave commented out unless you need them
# ---------------------------------------------------------------------------

# Custom endpoints
# FREEIMAGE_UPLOAD_URL=https://freeimage.host/api/1/upload
# IMGBB_UPLOAD_URL=https://api.imgbb.com/1/upload
# IMAGEKIT_UPLOAD_URL=https://upload.imagekit.io/api/v1/files/upload
# APILAYER_UPLOAD_URL=https://api.apilayer.com/image_upload/upload
