# ===========================================================================
#   PASTE YOUR SECRET KEYS HERE  --  this is the main secrets file.
#
#   Where:  the top level of your workspace, next to the "image_pipeline" folder.
#   How:    type the key after the "=" sign. No quotes. No spaces.
#
#           FREEIMAGE_API_KEY=abc123yourkeyhere
#
#   Then run the pipeline exactly as usual:
#           cd image_pipeline
#           python3 main.py --input sample_input.csv --workers 4
#
#   A key exported in the shell (or a Colab secret) always wins over this file.
#   This file is listed in .gitignore - it is never committed or shared.
# ===========================================================================

# freeimage.host API key  (primary uploader)
FREEIMAGE_API_KEY=

# ImgBB API key (automatic fallback if freeimage.host fails, or primary if freeimage key is removed)
# Get your free key instantly at: https://api.imgbb.com/
IMGBB_API_KEY=

# ---------------------------------------------------------------------------
# Optional extras - leave commented out unless you need them
# ---------------------------------------------------------------------------

# A different freeimage.host endpoint
# FREEIMAGE_UPLOAD_URL=https://freeimage.host/api/1/upload
